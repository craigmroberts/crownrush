{
  "name": "crownrush",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A simple, addictive low-poly defend-and-build game: fight, collect coins, grow your army.",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview --host",
    "scout": "node tools/scout/scout.mjs",
    "probe": "node tools/probe/probe.mjs",
    "models": "node tools/models/compress.mjs",
    "icons": "node tools/icons/make-app-icons.mjs",
    "check": "node tools/checks/checks.mjs",
    "seeds": "node tools/seeds/seeds.mjs",
    "raids": "node tools/raids/raids.mjs",
    "triage": "node tools/triage/refine.mjs",
    "board": "node tools/board/stats.mjs && node tools/board/brand.mjs && node tools/board/cast.mjs && node tools/board/world.mjs && node tools/board/tools.mjs"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@gltf-transform/cli": "^4.5.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "eslint": "^10.10.0",
    "ktx2-encoder": "^0.6.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "vite": "^6.4.3"
  }
}
